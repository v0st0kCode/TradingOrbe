//@version=5
indicator("CRT Unified", overlay=true, max_bars_back=500)

// ═══════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════
bull_color     = input.color(color.rgb(0, 193, 118),    "Bullish Color",       group="Colors")
bear_color     = input.color(color.rgb(255, 59, 59),    "Bearish Color",       group="Colors")
c1_color       = input.color(color.new(color.gray, 75), "C1 Box Color",        group="Colors")

show_c1_box    = input.bool(true,  "Show H4 C1 Range Box",    group="Display")
show_h1_box    = input.bool(true,  "Show H1 Range Box",       group="Display")
show_dol       = input.bool(true,  "Show DOL Line",           group="Display")
show_ob_box    = input.bool(true,  "Show Order Block Box",    group="Display")
show_levels    = input.bool(true,  "Show Entry/SL/TP Lines",  group="Display")
show_rr        = input.bool(true,  "Show RR Label",           group="Display")
show_panel     = input.bool(true,  "Show Info Panel",         group="Display")
use_daily_bias = input.bool(false, "Require Daily Bias",      group="Filters")
c3_window      = input.int(3, "C3 confirm window (H4 bars)",  minval=1, maxval=10, group="Filters")
setup_max_bars = input.int(6, "Setup persistence (H4 bars)",  minval=1, maxval=30, group="Filters")

// ═══════════════════════════════════════════════════
// TIMEFRAME DETECTION
// ═══════════════════════════════════════════════════
is_h4  = timeframe.period == "240"
is_h1  = timeframe.period == "60"
is_m15 = timeframe.period == "15"

// ═══════════════════════════════════════════════════
// STATE VARIABLES (declared early to avoid forward reference errors)
// ═══════════════════════════════════════════════════
// H4
var int   h4_state        = 0
var float c1_high         = na
var float c1_low          = na
var int   c1_bar          = na
var float c2_high         = na
var float c2_low          = na
var int   h4_direction    = 0   // 1=long, -1=short
var float c2_wick_ext     = na  // C2 wick extreme (SL reference)
var float dol_level       = na  // Draw on Liquidity target
var int   setup_bar       = na  // bar_index where C3 confirmed
var int   h4_period_start = na  // bar_index where current H4 started
var int   c2_age          = 0   // H4 bars elapsed since C2 formed (C3 window counter)
var int   setup_age       = 0   // H4 bars elapsed since SETUP (state 3 persistence counter)
var label c2_lbl          = na  // current C2 label (deleted on reset)
var label setup_lbl       = na  // current SETUP label (deleted on reset)
var label h1_ts_lbl       = na  // current H1 TS label (deleted on reset)
// H1
var float h1_prev_high    = na
var float h1_prev_low     = na
var bool  h1_confirmed    = false
var float h1_ts_prev_high = na  // prev H1 candle high at moment of TS (for box visual)
var float h1_ts_prev_low  = na  // prev H1 candle low at moment of TS
var int   h1_ts_bar       = na  // bar_index of the H1 TS candle
var int   h1_ts_time      = na  // timestamp of the H1 TS candle (for xloc.bar_time label)
// OB
var float ob_high         = na
var float ob_low          = na
var int   ob_bar          = na
var bool  ob_alerted      = false
var int   drawn_ob_bar    = na

// ═══════════════════════════════════════════════════
// DAILY BIAS
// ═══════════════════════════════════════════════════
// lookahead_off → returns last CLOSED daily bar
d_prev_high = request.security(syminfo.tickerid, "D", high, lookahead=barmerge.lookahead_off)
d_prev_low  = request.security(syminfo.tickerid, "D", low,  lookahead=barmerge.lookahead_off)

// Today's running high/low tracked from intraday bars
var float d_today_high = na
var float d_today_low  = na
bool new_day = ta.change(time("D")) != 0
if new_day
    d_today_high := high
    d_today_low  := low
else
    d_today_high := math.max(nz(d_today_high), high)
    d_today_low  := math.min(nz(d_today_low),  low)

// Bias: swept prev-day extreme AND price is back inside (CRT fakeout)
bool daily_bull = d_today_low  <= d_prev_low  and close > d_prev_low
bool daily_bear = d_today_high >= d_prev_high and close < d_prev_high

string bias_str = daily_bull and not daily_bear ? "BULLISH" : daily_bear and not daily_bull ? "BEARISH" : daily_bull and daily_bear ? "NEUTRAL*" : "NEUTRAL"
color  bias_col = daily_bull and not daily_bear ? bull_color : daily_bear and not daily_bull ? bear_color : color.gray

// ═══════════════════════════════════════════════════
// H4 DATA
// ═══════════════════════════════════════════════════
// lookahead_off → returns last CLOSED H4 bar (no [1] needed)
h4_time  = request.security(syminfo.tickerid, "240", time,  lookahead=barmerge.lookahead_off)
h4_high  = request.security(syminfo.tickerid, "240", high,  lookahead=barmerge.lookahead_off)
h4_low   = request.security(syminfo.tickerid, "240", low,   lookahead=barmerge.lookahead_off)
h4_close = request.security(syminfo.tickerid, "240", close, lookahead=barmerge.lookahead_off)

bool new_h4_bar = ta.change(h4_time) != 0

// ═══════════════════════════════════════════════════
// H4 STATE MACHINE
// ═══════════════════════════════════════════════════
if new_h4_bar
    float jc_high  = h4_high
    float jc_low   = h4_low
    float jc_close = h4_close
    int   this_c1_bar = na(h4_period_start) ? bar_index : h4_period_start

    if h4_state == 0
        c1_high    := jc_high
        c1_low     := jc_low
        c1_bar     := this_c1_bar
        h4_state   := 1

    else if h4_state == 1
        bool bull_c2 = jc_low  < c1_low  and jc_close > c1_low  and (not use_daily_bias or daily_bull)
        bool bear_c2 = jc_high > c1_high and jc_close < c1_high and (not use_daily_bias or daily_bear)

        if bull_c2
            h4_direction := 1
            c2_high      := jc_high
            c2_low       := jc_low
            c2_wick_ext  := jc_low
            dol_level    := c1_high
            c2_age       := 0
            h4_state     := 2
        else if bear_c2
            h4_direction := -1
            c2_high      := jc_high
            c2_low       := jc_low
            c2_wick_ext  := jc_high
            dol_level    := c1_low
            c2_age       := 0
            h4_state     := 2
        else
            c1_high      := jc_high
            c1_low       := jc_low
            c1_bar       := this_c1_bar
            h4_direction := 0
            c2_wick_ext  := na
            dol_level    := na

    else if h4_state == 2
        c2_age := c2_age + 1
        bool bull_c3 = h4_direction ==  1 and jc_close > c2_high
        bool bear_c3 = h4_direction == -1 and jc_close < c2_low
        // Invalidation: H4 closed beyond the C2 sweep wick (manipulation extended — not a reversal)
        bool c2_invalid = (h4_direction == 1 and jc_close < c2_wick_ext) or (h4_direction == -1 and jc_close > c2_wick_ext)

        if bull_c3 or bear_c3
            h4_state  := 3
            setup_bar := bar_index
            setup_age := 0
        else if c2_invalid or c2_age >= c3_window
            // C3 window expired or sweep invalidated — clear labels and reset
            label.delete(c2_lbl)
            label.delete(setup_lbl)
            label.delete(h1_ts_lbl)
            c2_lbl    := na
            setup_lbl := na
            h1_ts_lbl := na
            c1_high      := jc_high
            c1_low       := jc_low
            c1_bar       := this_c1_bar
            h4_direction := 0
            c2_wick_ext  := na
            dol_level    := na
            c2_age       := 0
            h4_state     := 1
        // else: still within C3 window — keep waiting (state stays 2, C1/C2 anchors preserved)

    else if h4_state == 3
        setup_age := setup_age + 1
        // Invalidation: H4 closed beyond the C2 sweep wick — thesis dead
        bool setup_invalid = (h4_direction == 1 and jc_close < c2_wick_ext) or (h4_direction == -1 and jc_close > c2_wick_ext)
        if setup_invalid or setup_age >= setup_max_bars
            // SETUP invalidated or persistence timeout — clear labels and reset
            label.delete(c2_lbl)
            label.delete(setup_lbl)
            label.delete(h1_ts_lbl)
            c2_lbl    := na
            setup_lbl := na
            h1_ts_lbl := na
            c1_high      := jc_high
            c1_low       := jc_low
            c1_bar       := this_c1_bar
            h4_direction := 0
            c2_wick_ext  := na
            dol_level    := na
            setup_bar    := na
            setup_age    := 0
            h4_state     := 1
        // else: SETUP persists across H4 bars — waiting for H1 TS / M15 OB / DOL

    h4_period_start := bar_index

// DOL mitigated: price reached target — reset setup
bool dol_mitigated = h4_state == 3 and not new_h4_bar and not na(dol_level) and
     (h4_direction == 1 ? high >= dol_level : low <= dol_level)

if dol_mitigated
    // DOL reached — clear labels and reset everything
    label.delete(c2_lbl)
    label.delete(setup_lbl)
    label.delete(h1_ts_lbl)
    c2_lbl    := na
    setup_lbl := na
    h1_ts_lbl := na
    dol_level    := na
    setup_bar    := na
    h4_direction := 0
    c2_wick_ext  := na
    c2_age       := 0
    setup_age    := 0
    h4_state     := 1
    // H1 reset
    h1_confirmed    := false
    h1_ts_prev_high := na
    h1_ts_prev_low  := na
    h1_ts_bar       := na
    h1_ts_time      := na
    // OB reset
    ob_high      := na
    ob_low       := na
    ob_bar       := na
    ob_alerted   := false
    drawn_ob_bar := na

bool h4_setup_active = h4_state == 3

// ═══════════════════════════════════════════════════
// H1 DATA
// ═══════════════════════════════════════════════════
// Always use request.security for H1 data (consistent on all TFs including H1 itself)
// lookahead_off returns last CLOSED H1 bar — correct on H1, M15, and H4
h1_time  = request.security(syminfo.tickerid, "60", time,  lookahead=barmerge.lookahead_off)
h1_high  = request.security(syminfo.tickerid, "60", high,  lookahead=barmerge.lookahead_off)
h1_low   = request.security(syminfo.tickerid, "60", low,   lookahead=barmerge.lookahead_off)
h1_close = request.security(syminfo.tickerid, "60", close, lookahead=barmerge.lookahead_off)

bool new_h1_bar = ta.change(h1_time) != 0

// ═══════════════════════════════════════════════════
// H1 TURTLE SOUP (confirmation layer)
// ═══════════════════════════════════════════════════
// Active only when h4_setup_active.
// Detects a H1 candle that wicks beyond prev H1 extreme AND closes back inside.
// Must align with H4 direction.

if new_h1_bar
    float prev_h = h1_prev_high
    float prev_l = h1_prev_low
    float jc_h   = h1_high
    float jc_l   = h1_low
    float jc_c   = h1_close

    // Reset H1 state when H4 setup is not active
    if not h4_setup_active
        h1_confirmed    := false
        h1_ts_prev_high := na
        h1_ts_prev_low  := na
        h1_ts_bar       := na
        h1_ts_time      := na

    // Check for H1 Turtle Soup aligned with H4 direction
    if h4_setup_active and not na(prev_h) and not na(prev_l)
        // Long: H1 sweeps prev low, closes inside prev candle range
        bool h1_bull_ts = h4_direction == 1 and jc_l < prev_l and jc_c > prev_l and jc_c < prev_h
        // Short: H1 sweeps prev high, closes inside prev candle range
        bool h1_bear_ts = h4_direction == -1 and jc_h > prev_h and jc_c < prev_h and jc_c > prev_l

        if (h1_bull_ts or h1_bear_ts) and not h1_confirmed
            h1_confirmed    := true
            h1_ts_prev_high := prev_h
            h1_ts_prev_low  := prev_l
            h1_ts_bar       := bar_index
            h1_ts_time      := int(h1_time)

    // Update prev H1 values AFTER the TS check (so we compare against the closed bar)
    h1_prev_high := h1_high
    h1_prev_low  := h1_low

// Also reset H1 when DOL mitigated (add to existing dol_mitigated block is done in Task 13)
// Here we just declare full_setup
bool full_setup = h4_setup_active and h1_confirmed

// ═══════════════════════════════════════════════════
// M15 ORDER BLOCK DETECTION
// ═══════════════════════════════════════════════════
// OB = last opposing candle whose BODY is fully engulfed by next candle's body (Cluti rule)
// Only active when full_setup (H4 + H1 both confirmed) AND chart is M15 (entry TF per CRT model)

bool is_bull_bar  = close > open
bool is_bear_bar  = close < open
bool prev_is_bull = close[1] > open[1]
bool prev_is_bear = close[1] < open[1]

// Bullish engulfing: current bull body fully covers prev bear body
bool bull_engulf = is_bull_bar and prev_is_bear and open <= close[1] and close >= open[1]
// Bearish engulfing: current bear body fully covers prev bull body
bool bear_engulf = is_bear_bar and prev_is_bull and open >= close[1] and close <= open[1]

if full_setup and is_m15
    if h4_direction == 1 and bull_engulf
        ob_high    := open[1]   // bearish OB: open = body top
        ob_low     := close[1]  // bearish OB: close = body bottom
        ob_bar     := bar_index - 1
        ob_alerted := false
    else if h4_direction == -1 and bear_engulf
        ob_high    := close[1]  // bullish OB: close = body top
        ob_low     := open[1]   // bullish OB: open = body bottom
        ob_bar     := bar_index - 1
        ob_alerted := false

// Invalidate OB if price closes beyond C2 wick extreme
if not na(ob_high) and not na(c2_wick_ext) and full_setup
    if (h4_direction == 1 and close < c2_wick_ext) or
       (h4_direction == -1 and close > c2_wick_ext)
        ob_high    := na
        ob_low     := na
        ob_bar     := na
        ob_alerted := false

// Clear OB state when full_setup ends
if not full_setup
    ob_high      := na
    ob_low       := na
    ob_bar       := na
    ob_alerted   := false
    drawn_ob_bar := na

bool ob_detected = full_setup and not na(ob_high)

// ═══════════════════════════════════════════════════
// TRADE LEVELS
// ═══════════════════════════════════════════════════
pip_size = syminfo.mintick * 10  // 1 pip for 5-decimal pairs (EUR/USD, GBP/USD)

float entry_price = na
float sl_price    = na
float tp1_price   = na
float tp2_price   = na
float rr_ratio    = na

if ob_detected and not na(c2_wick_ext) and not na(c1_high) and not na(c1_low)
    if h4_direction == 1
        entry_price := ob_high
        sl_price    := c2_wick_ext - 3 * pip_size
        tp1_price   := c1_low + (c1_high - c1_low) * 0.5
        tp2_price   := dol_level
        rr_ratio    := (tp2_price - entry_price) / (entry_price - sl_price)
    else
        entry_price := ob_low
        sl_price    := c2_wick_ext + 3 * pip_size
        tp1_price   := c1_high - (c1_high - c1_low) * 0.5
        tp2_price   := dol_level
        rr_ratio    := (entry_price - tp2_price) / (sl_price - entry_price)

// ═══════════════════════════════════════════════════
// ALERT
// ═══════════════════════════════════════════════════
if ob_detected and not ob_alerted
    ob_alerted := true
    alert(
         "CRT Setup — " + syminfo.ticker + " | " + str.tostring(timeframe.period) + "m\n" +
         "Direction: " + (h4_direction == 1 ? "LONG" : "SHORT") + "\n" +
         "Entry: "     + str.tostring(entry_price, "#.#####") + "\n" +
         "SL: "        + str.tostring(sl_price,    "#.#####") + "\n" +
         "TP1: "       + str.tostring(tp1_price,   "#.#####") + "  (50% H4 C1 range)\n" +
         "TP2 / DOL: " + str.tostring(tp2_price,   "#.#####") + "\n" +
         "RR: 1:"      + str.tostring(rr_ratio,    "#.##"),
         alert.freq_once_per_bar_close)

// ═══════════════════════════════════════════════════
// VISUALS — H4 C1 BOX
// ═══════════════════════════════════════════════════
// Primary on H4, faded on H1/M15. Hidden on other TFs.
bool show_h4_c1 = (is_h4 or is_h1 or is_m15) and show_c1_box and not na(c1_high) and not na(c1_bar)
color c1_box_color = is_h4 ? c1_color : color.new(color.gray, 90)

var box c1_box_obj = na

if show_h4_c1
    if na(c1_box_obj)
        c1_box_obj := box.new(
             left=c1_bar, top=c1_high, right=bar_index + 50, bottom=c1_low,
             border_color=color.new(color.gray, 60), bgcolor=c1_box_color,
             extend=extend.right, xloc=xloc.bar_index)
    else
        box.set_left(c1_box_obj,   c1_bar)
        box.set_top(c1_box_obj,    c1_high)
        box.set_bottom(c1_box_obj, c1_low)
        box.set_right(c1_box_obj,  bar_index + 50)
        box.set_bgcolor(c1_box_obj, c1_box_color)

// ═══════════════════════════════════════════════════
// VISUALS — DOL LINE
// ═══════════════════════════════════════════════════
bool show_dol_line = (is_h4 or is_h1 or is_m15) and show_dol

var line  dol_line_obj  = na
var label dol_label_obj = na

if show_dol_line
    if h4_state == 3 and not na(dol_level) and not na(setup_bar)
        color _dol_col = h4_direction == 1 ? bull_color : bear_color
        if na(dol_line_obj)
            dol_line_obj  := line.new(x1=setup_bar, y1=dol_level, x2=bar_index + 50, y2=dol_level,
                 color=color.new(_dol_col, 20), style=line.style_dashed, width=2, extend=extend.right)
            dol_label_obj := label.new(bar_index + 2, dol_level, "DOL",
                 color=color.new(_dol_col, 80), textcolor=_dol_col,
                 style=label.style_label_left, size=size.tiny)
        else
            line.set_x2(dol_line_obj, bar_index + 50)
            label.set_x(dol_label_obj, bar_index + 2)
    else
        if not na(dol_line_obj)
            line.delete(dol_line_obj)
            label.delete(dol_label_obj)
            dol_line_obj  := na
            dol_label_obj := na

// ═══════════════════════════════════════════════════
// VISUALS — H4 C2/C3 LABELS (H4 chart only)
// ═══════════════════════════════════════════════════
if is_h4 and new_h4_bar
    if h4_state == 2
        color _c2_col = h4_direction == 1 ? bull_color : bear_color
        label.delete(c2_lbl)
        c2_lbl := label.new(int(h4_time), h4_direction == 1 ? h4_low : h4_high, "C2",
             color=color.new(_c2_col, 60), textcolor=_c2_col,
             style=h4_direction == 1 ? label.style_label_up : label.style_label_down,
             yloc=yloc.price, xloc=xloc.bar_time, size=size.small)
    if h4_state == 3
        color _c3_col = h4_direction == 1 ? bull_color : bear_color
        label.delete(setup_lbl)
        setup_lbl := label.new(int(h4_time), h4_direction == 1 ? h4_low : h4_high, h4_direction == 1 ? "SETUP ▲" : "SETUP ▼",
             color=color.new(_c3_col, 60), textcolor=_c3_col,
             style=h4_direction == 1 ? label.style_label_up : label.style_label_down,
             yloc=yloc.price, xloc=xloc.bar_time, size=size.small)

// ═══════════════════════════════════════════════════
// VISUALS — H1 TURTLE SOUP LABEL (H1 chart only)
// ═══════════════════════════════════════════════════
// Fires once on the bar where H1 TS is confirmed
if is_h1 and new_h1_bar and h4_setup_active and h1_confirmed
    // Check: was this the bar where h1_ts_bar was just set?
    if h1_ts_bar == bar_index and not na(h1_ts_time)
        color _ts_col = h4_direction == 1 ? bull_color : bear_color
        label.delete(h1_ts_lbl)
        h1_ts_lbl := label.new(h1_ts_time, h4_direction == 1 ? h1_ts_prev_low : h1_ts_prev_high, "H1 TS ✓",
             color=color.new(_ts_col, 60), textcolor=_ts_col,
             style=h4_direction == 1 ? label.style_label_up : label.style_label_down,
             yloc=yloc.price, xloc=xloc.bar_time, size=size.small)

// ═══════════════════════════════════════════════════
// VISUALS — M15 OB BOX + ENTRY/SL/TP LINES
// ═══════════════════════════════════════════════════
color _col = h4_direction == 1 ? bull_color : bear_color

var box   ob_box_obj = na
var line  entry_ln   = na
var line  sl_ln      = na
var line  tp1_ln     = na
var line  tp2_ln     = na
var label rr_lbl     = na

// When OB changes, delete old drawings so they get recreated with new levels
bool ob_changed = ob_detected and not na(ob_bar) and ob_bar != drawn_ob_bar
if ob_changed
    box.delete(ob_box_obj)
    ob_box_obj := na
    line.delete(entry_ln)
    entry_ln   := na
    line.delete(sl_ln)
    sl_ln      := na
    line.delete(tp1_ln)
    tp1_ln     := na
    line.delete(tp2_ln)
    tp2_ln     := na
    label.delete(rr_lbl)
    rr_lbl     := na
    drawn_ob_bar := ob_bar

if ob_detected and not na(ob_bar) and not na(entry_price) and is_m15
    if show_ob_box
        if na(ob_box_obj)
            ob_box_obj := box.new(
                 left=ob_bar, top=ob_high, right=bar_index + 50, bottom=ob_low,
                 border_color=color.new(_col, 30), bgcolor=color.new(_col, 80),
                 extend=extend.right, xloc=xloc.bar_index)
        else
            box.set_right(ob_box_obj, bar_index + 50)

    if show_levels
        if na(entry_ln)
            entry_ln := line.new(ob_bar, entry_price, bar_index + 50, entry_price,
                 color=_col, width=1, extend=extend.right, xloc=xloc.bar_index)
            sl_ln    := line.new(ob_bar, sl_price,    bar_index + 50, sl_price,
                 color=bear_color, style=line.style_dashed, width=1, extend=extend.right, xloc=xloc.bar_index)
            tp1_ln   := line.new(ob_bar, tp1_price,   bar_index + 50, tp1_price,
                 color=color.orange, style=line.style_dashed, width=1, extend=extend.right, xloc=xloc.bar_index)
            tp2_ln   := line.new(ob_bar, tp2_price,   bar_index + 50, tp2_price,
                 color=bull_color, style=line.style_dashed, width=2, extend=extend.right, xloc=xloc.bar_index)
        else
            line.set_x2(entry_ln, bar_index + 50)
            line.set_x2(sl_ln,    bar_index + 50)
            line.set_x2(tp1_ln,   bar_index + 50)
            line.set_x2(tp2_ln,   bar_index + 50)

    if show_rr and not na(rr_ratio)
        if na(rr_lbl)
            rr_lbl := label.new(bar_index + 2, tp2_price,
                 "RR 1:" + str.tostring(rr_ratio, "#.#"),
                 color=color.new(bull_color, 80), textcolor=bull_color,
                 style=label.style_label_left, size=size.tiny)
        else
            label.set_x(rr_lbl, bar_index + 2)
else
    box.delete(ob_box_obj)
    ob_box_obj := na
    line.delete(entry_ln)
    entry_ln   := na
    line.delete(sl_ln)
    sl_ln      := na
    line.delete(tp1_ln)
    tp1_ln     := na
    line.delete(tp2_ln)
    tp2_ln     := na
    label.delete(rr_lbl)
    rr_lbl     := na
    drawn_ob_bar := na


// ═══════════════════════════════════════════════════
// INFO PANEL
// ═══════════════════════════════════════════════════
string h4_state_str = h4_state == 0 ? "IDLE" : h4_state == 1 ? "C1" : h4_state == 2 ? (h4_direction == 1 ? "C2 LONG" : "C2 SHORT") : h4_state == 3 ? (h4_direction == 1 ? "SETUP ▲" : "SETUP ▼") : "?"
color  h4_state_col = h4_state == 3 ? (h4_direction == 1 ? bull_color : bear_color) : h4_state == 2 ? color.orange : color.gray

string h1_conf_str = not h4_setup_active ? "—" : h1_confirmed ? "CONFIRMED ✓" : "WAIT"
color  h1_conf_col = not h4_setup_active ? color.gray : h1_confirmed ? bull_color : color.orange

string dol_str = (not h4_setup_active or na(dol_level)) ? "—" : str.tostring(dol_level, "#.#####")

string status_str = ob_detected                              ? "OB ▶ ENTRY" :
     full_setup and not ob_detected                          ? "WAIT OB" :
     h4_setup_active and not h1_confirmed                    ? "WAIT H1 TS" :
     h4_state == 2                                           ? "WAIT C3" : "—"
color  status_col = ob_detected                              ? (h4_direction == 1 ? bull_color : bear_color) :
     h4_state >= 2                                           ? color.orange : color.gray

color col_lbl = color.rgb(200, 200, 210)
color col_dol = color.rgb(100, 160, 255)
color col_bg  = color.new(color.rgb(15, 15, 28), 20)

var table info_tbl = table.new(position.top_right, 2, 5,
     bgcolor=color.new(color.rgb(10, 10, 20), 15),
     border_color=color.new(color.gray, 50), border_width=1,
     frame_color=color.new(color.gray, 40), frame_width=1)

if barstate.islast and show_panel
    table.cell(info_tbl, 0, 0, "BIAS",        text_color=col_lbl,       text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 1, 0, bias_str,       text_color=bias_col,      text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 0, 1, "H4",           text_color=col_lbl,       text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 1, 1, h4_state_str,   text_color=h4_state_col,  text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 0, 2, "H1",           text_color=col_lbl,       text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 1, 2, h1_conf_str,    text_color=h1_conf_col,   text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 0, 3, "STATUS",       text_color=col_lbl,       text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 1, 3, status_str,     text_color=status_col,    text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 0, 4, "DOL",          text_color=col_lbl,       text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 1, 4, dol_str,        text_color=col_dol,       text_size=size.normal, bgcolor=col_bg)

// ═══════════════════════════════════════════════════
// VISUALS — H1 RANGE BOX (H1 and M15 charts)
// ═══════════════════════════════════════════════════
// Shows the range of the H1 candle PRIOR to the Turtle Soup
// Helps visualize the H1 sweet zone for entry
bool show_h1_range = (is_h1 or is_m15) and show_h1_box and h1_confirmed and not na(h1_ts_prev_high)

color h1_box_col = is_h1 ? color.new(h4_direction == 1 ? bull_color : bear_color, 85) : color.new(color.gray, 92)

var box h1_box_obj = na

if show_h1_range
    if na(h1_box_obj)
        h1_box_obj := box.new(
             left=h1_ts_bar, top=h1_ts_prev_high, right=bar_index + 50, bottom=h1_ts_prev_low,
             border_color=color.new(h4_direction == 1 ? bull_color : bear_color, 50),
             bgcolor=h1_box_col,
             extend=extend.right, xloc=xloc.bar_index)
    else
        box.set_right(h1_box_obj, bar_index + 50)
        box.set_bgcolor(h1_box_obj, h1_box_col)
else
    if not na(h1_box_obj)
        box.delete(h1_box_obj)
        h1_box_obj := na
