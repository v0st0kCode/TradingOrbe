//@version=5
indicator("CRT Unified", overlay=true, max_bars_back=500)

// INPUTS
bull_color     = input.color(color.rgb(0, 193, 118),    "Bullish Color",       group="Colors")
bear_color     = input.color(color.rgb(255, 59, 59),    "Bearish Color",       group="Colors")
c1_color       = input.color(color.new(color.gray, 75), "C1 Box Color",        group="Colors")

show_c1_box    = input.bool(true,  "Show H4 C1 Range Box",    group="Display")
show_h1_box    = input.bool(true,  "Show H1 Range Box",       group="Display")
show_dol       = input.bool(true,  "Show DOL Line",           group="Display")
show_ob_box    = input.bool(true,  "Show Order Block Box",    group="Display")
show_levels    = input.bool(true,  "Show Entry/SL/TP Lines",  group="Display")
show_rr        = input.bool(true,  "Show RR Label",           group="Display")
show_panel     = input.bool(true,  "Show Info Panel",         group="Display")
show_backtest  = input.bool(true,  "Show Backtest Engine",    group="Display")
use_daily_bias = input.bool(false, "Require Daily Bias",      group="Filters")
c3_window      = input.int(3, "C3 confirm window (H4 bars)",  minval=1, maxval=10, group="Filters")
setup_max_bars = input.int(6, "Setup persistence (H4 bars)",  minval=1, maxval=30, group="Filters")

// TIMEFRAME DETECTION
is_h4  = timeframe.period == "240"
is_h1  = timeframe.period == "60"
is_m15 = timeframe.period == "15"

// STATE VARIABLES
var int   h4_state        = 0
var float c1_high         = na
var float c1_low          = na
var int   c1_bar          = na
var float c2_high         = na
var float c2_low          = na
var int   h4_direction    = 0
var float c2_wick_ext     = na
var float dol_level       = na
var int   setup_bar       = na
var int   h4_period_start = na
var int   c2_age          = 0
var int   setup_age       = 0
var label c2_lbl          = na
var label setup_lbl       = na
var label h1_ts_lbl       = na
var float h1_prev_high    = na
var float h1_prev_low     = na
var bool  h1_confirmed    = false
var float h1_ts_prev_high = na
var float h1_ts_prev_low  = na
var int   h1_ts_bar       = na
var int   h1_ts_time      = na
var int   contact_c1_bar  = na
var float ltf_c1_high     = na
var float ltf_c1_low      = na
var bool  contact_found   = false
var float ob_high         = na
var float ob_low          = na
var int   ob_bar          = na
var bool  ob_alerted      = false
var int   drawn_ob_bar    = na

// BACKTEST VARIABLES
var float bt_entry_price  = na
var float bt_sl_price     = na
var float bt_tp1_price    = na
var float bt_tp2_price    = na
var int   bt_entry_bar    = na
var int   bt_dir          = 0
var int   bt_exit_reason  = 0
var float bt_result_pips  = na
var int   bt_total_trades = 0
var int   bt_wins         = 0
var float bt_total_pips   = 0.0
var float bt_max_pips     = na
var float bt_min_pips     = na

// DAILY BIAS
d_prev_high = request.security(syminfo.tickerid, "D", high, lookahead=barmerge.lookahead_off)
d_prev_low  = request.security(syminfo.tickerid, "D", low,  lookahead=barmerge.lookahead_off)
var float d_today_high = na
var float d_today_low  = na
bool new_day = ta.change(time("D")) != 0
if new_day
    d_today_high := high
    d_today_low  := low
else
    d_today_high := math.max(nz(d_today_high), high)
    d_today_low  := math.min(nz(d_today_low),  low)
bool daily_bull = d_today_low  <= d_prev_low  and close > d_prev_low
bool daily_bear = d_today_high >= d_prev_high and close < d_prev_high
string bias_str = daily_bull and not daily_bear ? "BULLISH" : daily_bear and not daily_bull ? "BEARISH" : daily_bull and daily_bear ? "NEUTRAL*" : "NEUTRAL"
color  bias_col = daily_bull and not daily_bear ? bull_color : daily_bear and not daily_bull ? bear_color : color.gray

// H4 DATA
h4_time  = request.security(syminfo.tickerid, "240", time,  lookahead=barmerge.lookahead_off)
h4_high  = request.security(syminfo.tickerid, "240", high,  lookahead=barmerge.lookahead_off)
h4_low   = request.security(syminfo.tickerid, "240", low,   lookahead=barmerge.lookahead_off)
h4_close = request.security(syminfo.tickerid, "240", close, lookahead=barmerge.lookahead_off)
bool new_h4_bar = ta.change(h4_time) != 0

// H4 STATE MACHINE
if new_h4_bar
    float jc_high  = h4_high
    float jc_low   = h4_low
    float jc_close = h4_close
    int   this_c1_bar = na(h4_period_start) ? bar_index : h4_period_start
    if h4_state == 0
        c1_high    := jc_high
        c1_low     := jc_low
        c1_bar     := this_c1_bar
        h4_state   := 1
    else if h4_state == 1
        bool bull_c2 = jc_low  < c1_low  and jc_close > c1_low  and (not use_daily_bias or daily_bull)
        bool bear_c2 = jc_high > c1_high and jc_close < c1_high and (not use_daily_bias or daily_bear)
        if bull_c2
            h4_direction := 1
            c2_high      := jc_high
            c2_low       := jc_low
            c2_wick_ext  := jc_low
            dol_level    := c1_high
            c2_age       := 0
            h4_state     := 2
        else if bear_c2
            h4_direction := -1
            c2_high      := jc_high
            c2_low       := jc_low
            c2_wick_ext  := jc_high
            dol_level    := c1_low
            c2_age       := 0
            h4_state     := 2
        else
            c1_high      := jc_high
            c1_low       := jc_low
            c1_bar       := this_c1_bar
            h4_direction := 0
            c2_wick_ext  := na
            dol_level    := na
    else if h4_state == 2
        c2_age := c2_age + 1
        bool bull_c3 = h4_direction ==  1 and jc_close > c2_high
        bool bear_c3 = h4_direction == -1 and jc_close < c2_low
        bool c2_invalid = (h4_direction == 1 and jc_close < c2_wick_ext) or (h4_direction == -1 and jc_close > c2_wick_ext)
        if bull_c3 or bear_c3
            h4_state  := 3
            setup_bar := bar_index
            setup_age := 0
        else if c2_invalid or c2_age >= c3_window
            label.delete(c2_lbl)
            label.delete(setup_lbl)
            label.delete(h1_ts_lbl)
            c2_lbl    := na
            setup_lbl := na
            h1_ts_lbl := na
            c1_high      := jc_high
            c1_low       := jc_low
            c1_bar       := this_c1_bar
            h4_direction := 0
            c2_wick_ext  := na
            dol_level    := na
            c2_age       := 0
            h4_state     := 1
    else if h4_state == 3
        setup_age := setup_age + 1
        bool setup_invalid = (h4_direction == 1 and jc_close < c2_wick_ext) or (h4_direction == -1 and jc_close > c2_wick_ext)
        if setup_invalid or setup_age >= setup_max_bars
            label.delete(c2_lbl)
            label.delete(setup_lbl)
            label.delete(h1_ts_lbl)
            c2_lbl    := na
            setup_lbl := na
            h1_ts_lbl := na
            c1_high      := jc_high
            c1_low       := jc_low
            c1_bar       := this_c1_bar
            h4_direction := 0
            c2_wick_ext  := na
            dol_level    := na
            setup_bar    := na
            setup_age    := 0
            h4_state     := 1
    h4_period_start := bar_index

// DOL mitigated
bool dol_mitigated = h4_state == 3 and not new_h4_bar and not na(dol_level) and
     (h4_direction == 1 ? high >= dol_level : low <= dol_level)
if dol_mitigated
    label.delete(c2_lbl)
    label.delete(setup_lbl)
    label.delete(h1_ts_lbl)
    c2_lbl    := na
    setup_lbl := na
    h1_ts_lbl := na
    dol_level    := na
    setup_bar    := na
    h4_direction := 0
    c2_wick_ext  := na
    c2_age       := 0
    setup_age    := 0
    h4_state     := 1
    h1_confirmed    := false
    h1_ts_prev_high := na
    h1_ts_prev_low  := na
    h1_ts_bar       := na
    h1_ts_time      := na
    ob_high      := na
    ob_low       := na
    ob_bar       := na
    ob_alerted   := false
    drawn_ob_bar := na

bool h4_setup_active = h4_state == 3

// H1 DATA
h1_time  = request.security(syminfo.tickerid, "60", time,  lookahead=barmerge.lookahead_off)
h1_high  = request.security(syminfo.tickerid, "60", high,  lookahead=barmerge.lookahead_off)
h1_low   = request.security(syminfo.tickerid, "60", low,   lookahead=barmerge.lookahead_off)
h1_close = request.security(syminfo.tickerid, "60", close, lookahead=barmerge.lookahead_off)
bool new_h1_bar = ta.change(h1_time) != 0

// H1 TURTLE SOUP
// Protocolo real (fuente: notebook CRT metodología):
// 1. Mientras se forma C2 (h4_state==2), localizar la vela H1 concreta que
//    perfora el nivel de C1 — esa vela pasa a ser la referencia LTF C1.
// 2. La confirmación es que una vela H1 posterior barra el extremo de ESA
//    vela de contacto y cierre de vuelta dentro de su rango.
// (Antes: barría la vela H1 anterior genérica + exigía quedar dentro del
// rango C1 completo, que ya está desactualizado en cuanto arranca C2 —
// por eso nunca confirmaba.)
if new_h1_bar
    float jc_h   = h1_high
    float jc_l   = h1_low
    float jc_c   = h1_close
    if not h4_setup_active
        h1_confirmed    := false
        h1_ts_prev_high := na
        h1_ts_prev_low  := na
        h1_ts_bar       := na
        h1_ts_time      := na
    if contact_c1_bar != c1_bar
        contact_found  := false
        ltf_c1_high    := na
        ltf_c1_low     := na
        contact_c1_bar := c1_bar
    if h4_state == 2 and not contact_found
        bool pierces_low  = h4_direction == 1  and jc_l < c1_low
        bool pierces_high = h4_direction == -1 and jc_h > c1_high
        if pierces_low or pierces_high
            ltf_c1_high   := jc_h
            ltf_c1_low    := jc_l
            contact_found := true
    if h4_setup_active and contact_found and not na(ltf_c1_high) and not na(ltf_c1_low)
        bool h1_bull_ts = h4_direction == 1  and jc_l < ltf_c1_low  and jc_c > ltf_c1_low  and jc_c < ltf_c1_high
        bool h1_bear_ts = h4_direction == -1 and jc_h > ltf_c1_high and jc_c < ltf_c1_high and jc_c > ltf_c1_low
        if (h1_bull_ts or h1_bear_ts) and not h1_confirmed
            h1_confirmed    := true
            h1_ts_prev_high := ltf_c1_high
            h1_ts_prev_low  := ltf_c1_low
            h1_ts_bar       := bar_index
            h1_ts_time      := int(h1_time)
    h1_prev_high := h1_high
    h1_prev_low  := h1_low

bool full_setup = h4_setup_active and h1_confirmed

// M15 ORDER BLOCK (via request.security for cross-TF detection)
[m15_open, m15_close, m15_open_1, m15_close_1] = request.security(syminfo.tickerid, "15",
     [open, close, open[1], close[1]], lookahead=barmerge.lookahead_off)

bool is_bull_bar  = m15_close > m15_open
bool is_bear_bar  = m15_close < m15_open
bool prev_is_bull = m15_close_1 > m15_open_1
bool prev_is_bear = m15_close_1 < m15_open_1
bool bull_engulf = is_bull_bar and prev_is_bear and m15_open <= m15_close_1 and m15_close >= m15_open_1
bool bear_engulf = is_bear_bar and prev_is_bull and m15_open >= m15_close_1 and m15_close <= m15_open_1

if full_setup
    if h4_direction == 1 and bull_engulf
        ob_high    := m15_open_1
        ob_low     := m15_close_1
        ob_bar     := bar_index - 1
        ob_alerted := false
    else if h4_direction == -1 and bear_engulf
        ob_high    := m15_close_1
        ob_low     := m15_open_1
        ob_bar     := bar_index - 1
        ob_alerted := false

if not na(ob_high) and not na(c2_wick_ext) and full_setup
    if (h4_direction == 1 and m15_close < c2_wick_ext) or
       (h4_direction == -1 and m15_close > c2_wick_ext)
        ob_high    := na
        ob_low     := na
        ob_bar     := na
        ob_alerted := false

if not full_setup
    ob_high      := na
    ob_low       := na
    ob_bar       := na
    ob_alerted   := false
    drawn_ob_bar := na

bool ob_detected = full_setup and not na(ob_high)

// TRADE LEVELS
pip_size = syminfo.mintick * 10
float entry_price = na
float sl_price    = na
float tp1_price   = na
float tp2_price   = na
float rr_ratio    = na

if ob_detected and not na(c2_wick_ext) and not na(c1_high) and not na(c1_low)
    if h4_direction == 1
        entry_price := ob_high
        sl_price    := c2_wick_ext - 3 * pip_size
        tp1_price   := c1_low + (c1_high - c1_low) * 0.5
        tp2_price   := dol_level
        rr_ratio    := (tp2_price - entry_price) / (entry_price - sl_price)
    else
        entry_price := ob_low
        sl_price    := c2_wick_ext + 3 * pip_size
        tp1_price   := c1_high - (c1_high - c1_low) * 0.5
        tp2_price   := dol_level
        rr_ratio    := (entry_price - tp2_price) / (sl_price - entry_price)

// BACKTEST ENGINE
bool bt_in_position = not na(bt_entry_price)
bool bt_trigger_long  = full_setup and h4_direction == 1 and bull_engulf
bool bt_trigger_short = full_setup and h4_direction == -1 and bear_engulf

if bt_trigger_long and not bt_in_position and not na(c2_wick_ext) and not na(c1_high) and not na(c1_low)
    bt_entry_price := open
    bt_sl_price    := c2_wick_ext - 3 * pip_size
    bt_tp1_price   := c1_low + (c1_high - c1_low) * 0.5
    bt_tp2_price   := dol_level
    bt_entry_bar   := bar_index + 1
    bt_dir         := 1

if bt_trigger_short and not bt_in_position and not na(c2_wick_ext) and not na(c1_high) and not na(c1_low)
    bt_entry_price := open
    bt_sl_price    := c2_wick_ext + 3 * pip_size
    bt_tp1_price   := c1_high - (c1_high - c1_low) * 0.5
    bt_tp2_price   := dol_level
    bt_entry_bar   := bar_index + 1
    bt_dir         := -1

bool bt_bars_since_entry = bt_in_position and (bar_index >= bt_entry_bar)

if bt_bars_since_entry and bt_exit_reason == 0
    int bt_bars_elapsed = bar_index - bt_entry_bar
    if bt_dir == 1
        if low <= bt_sl_price
            bt_exit_reason := 3
            bt_result_pips := -(bt_sl_price - bt_entry_price) / pip_size
        else if high >= bt_tp2_price
            bt_exit_reason := 1
            bt_result_pips := (bt_tp2_price - bt_entry_price) / pip_size
        else if high >= bt_tp1_price
            bt_exit_reason := 2
            bt_result_pips := (bt_tp1_price - bt_entry_price) / pip_size
        else if bt_bars_elapsed >= 10
            bt_exit_reason := 4
            bt_result_pips := (close - bt_entry_price) / pip_size
    if bt_dir == -1
        if high >= bt_sl_price
            bt_exit_reason := 3
            bt_result_pips := (bt_sl_price - bt_entry_price) / pip_size
        else if low <= bt_tp2_price
            bt_exit_reason := 1
            bt_result_pips := (bt_entry_price - bt_tp2_price) / pip_size
        else if low <= bt_tp1_price
            bt_exit_reason := 2
            bt_result_pips := (bt_entry_price - bt_tp1_price) / pip_size
        else if bt_bars_elapsed >= 10
            bt_exit_reason := 4
            bt_result_pips := (bt_entry_price - close) / pip_size

if bt_exit_reason != 0
    bt_total_trades += 1
    if bt_result_pips > 0
        bt_wins += 1
    bt_total_pips += bt_result_pips
    bt_max_pips := na(bt_max_pips) ? bt_result_pips : math.max(bt_max_pips, bt_result_pips)
    bt_min_pips := na(bt_min_pips) ? bt_result_pips : math.min(bt_min_pips, bt_result_pips)
    bt_entry_price := na
    bt_sl_price    := na
    bt_tp1_price   := na
    bt_tp2_price   := na
    bt_entry_bar   := na
    bt_dir         := 0
    bt_exit_reason := 0

float bt_win_rate = bt_total_trades > 0 ? bt_wins / bt_total_trades * 100 : 0.0
float bt_avg_pips = bt_total_trades > 0 ? bt_total_pips / bt_total_trades : 0.0

// ALERT
if ob_detected and not ob_alerted
    ob_alerted := true
    alert("CRT Setup - " + syminfo.ticker + " | " + str.tostring(timeframe.period) + "m\n" +
         "Direction: " + (h4_direction == 1 ? "LONG" : "SHORT") + "\n" +
         "Entry: "     + str.tostring(entry_price, "#.#####") + "\n" +
         "SL: "        + str.tostring(sl_price,    "#.#####") + "\n" +
         "TP1: "       + str.tostring(tp1_price,   "#.#####") + "  (50% H4 C1 range)\n" +
         "TP2 / DOL: " + str.tostring(tp2_price,   "#.#####") + "\n" +
         "RR: 1:"      + str.tostring(rr_ratio,    "#.##"), alert.freq_once_per_bar_close)

// VISUALS - H4 C1 BOX
bool show_h4_c1 = (is_h4 or is_h1 or is_m15) and show_c1_box and not na(c1_high) and not na(c1_bar)
color c1_box_color = is_h4 ? c1_color : color.new(color.gray, 90)
var box c1_box_obj = na
if show_h4_c1
    if na(c1_box_obj)
        c1_box_obj := box.new(left=c1_bar, top=c1_high, right=bar_index + 50, bottom=c1_low,
             border_color=color.new(color.gray, 60), bgcolor=c1_box_color, extend=extend.right, xloc=xloc.bar_index)
    else
        box.set_left(c1_box_obj,   c1_bar)
        box.set_top(c1_box_obj,    c1_high)
        box.set_bottom(c1_box_obj, c1_low)
        box.set_right(c1_box_obj,  bar_index + 50)
        box.set_bgcolor(c1_box_obj, c1_box_color)

// VISUALS - DOL LINE
bool show_dol_line = (is_h4 or is_h1 or is_m15) and show_dol
var line  dol_line_obj  = na
var label dol_label_obj = na
if show_dol_line
    if h4_state == 3 and not na(dol_level) and not na(setup_bar)
        color _dol_col = h4_direction == 1 ? bull_color : bear_color
        if na(dol_line_obj)
            dol_line_obj  := line.new(x1=setup_bar, y1=dol_level, x2=bar_index + 50, y2=dol_level,
                 color=color.new(_dol_col, 20), style=line.style_dashed, width=2, extend=extend.right)
            dol_label_obj := label.new(bar_index + 2, dol_level, "DOL",
                 color=color.new(_dol_col, 80), textcolor=_dol_col, style=label.style_label_left, size=size.tiny)
        else
            line.set_x2(dol_line_obj, bar_index + 50)
            label.set_x(dol_label_obj, bar_index + 2)
    else
        if not na(dol_line_obj)
            line.delete(dol_line_obj)
            label.delete(dol_label_obj)
            dol_line_obj  := na
            dol_label_obj := na

// VISUALS - H4 C2/C3 LABELS
if is_h4 and new_h4_bar
    if h4_state == 2
        color _c2_col = h4_direction == 1 ? bull_color : bear_color
        label.delete(c2_lbl)
        c2_lbl := label.new(int(h4_time), h4_direction == 1 ? h4_low : h4_high, "C2",
             color=color.new(_c2_col, 60), textcolor=_c2_col,
             style=h4_direction == 1 ? label.style_label_up : label.style_label_down,
             yloc=yloc.price, xloc=xloc.bar_time, size=size.small)
    if h4_state == 3
        color _c3_col = h4_direction == 1 ? bull_color : bear_color
        label.delete(setup_lbl)
        setup_lbl := label.new(int(h4_time), h4_direction == 1 ? h4_low : h4_high, h4_direction == 1 ? "SETUP ▲" : "SETUP ▼",
             color=color.new(_c3_col, 60), textcolor=_c3_col,
             style=h4_direction == 1 ? label.style_label_up : label.style_label_down,
             yloc=yloc.price, xloc=xloc.bar_time, size=size.small)

// VISUALS - H1 TS LABEL
if is_h1 and new_h1_bar and h4_setup_active and h1_confirmed
    if h1_ts_bar == bar_index and not na(h1_ts_time)
        color _ts_col = h4_direction == 1 ? bull_color : bear_color
        label.delete(h1_ts_lbl)
        h1_ts_lbl := label.new(h1_ts_time, h4_direction == 1 ? h1_ts_prev_low : h1_ts_prev_high, "H1 TS ✓",
             color=color.new(_ts_col, 60), textcolor=_ts_col,
             style=h4_direction == 1 ? label.style_label_up : label.style_label_down,
             yloc=yloc.price, xloc=xloc.bar_time, size=size.small)

// VISUALS - M15 OB BOX + LEVELS
color _col = h4_direction == 1 ? bull_color : bear_color
var box   ob_box_obj = na
var line  entry_ln   = na
var line  sl_ln      = na
var line  tp1_ln     = na
var line  tp2_ln     = na
var label rr_lbl     = na

bool ob_changed = ob_detected and not na(ob_bar) and ob_bar != drawn_ob_bar
if ob_changed
    box.delete(ob_box_obj)
    ob_box_obj := na
    line.delete(entry_ln)
    entry_ln   := na
    line.delete(sl_ln)
    sl_ln      := na
    line.delete(tp1_ln)
    tp1_ln     := na
    line.delete(tp2_ln)
    tp2_ln     := na
    label.delete(rr_lbl)
    rr_lbl     := na
    drawn_ob_bar := ob_bar

if ob_detected and not na(ob_bar) and not na(entry_price) and is_m15
    if show_ob_box
        if na(ob_box_obj)
            ob_box_obj := box.new(left=ob_bar, top=ob_high, right=bar_index + 50, bottom=ob_low,
                 border_color=color.new(_col, 30), bgcolor=color.new(_col, 80), extend=extend.right, xloc=xloc.bar_index)
        else
            box.set_right(ob_box_obj, bar_index + 50)
    if show_levels
        if na(entry_ln)
            entry_ln := line.new(ob_bar, entry_price, bar_index + 50, entry_price, color=_col, width=1, extend=extend.right, xloc=xloc.bar_index)
            sl_ln    := line.new(ob_bar, sl_price,    bar_index + 50, sl_price,    color=bear_color, style=line.style_dashed, width=1, extend=extend.right, xloc=xloc.bar_index)
            tp1_ln   := line.new(ob_bar, tp1_price,   bar_index + 50, tp1_price,   color=color.orange, style=line.style_dashed, width=1, extend=extend.right, xloc=xloc.bar_index)
            tp2_ln   := line.new(ob_bar, tp2_price,   bar_index + 50, tp2_price,   color=bull_color, style=line.style_dashed, width=2, extend=extend.right, xloc=xloc.bar_index)
        else
            line.set_x2(entry_ln, bar_index + 50)
            line.set_x2(sl_ln,    bar_index + 50)
            line.set_x2(tp1_ln,   bar_index + 50)
            line.set_x2(tp2_ln,   bar_index + 50)
    if show_rr and not na(rr_ratio)
        if na(rr_lbl)
            rr_lbl := label.new(bar_index + 2, tp2_price, "RR 1:" + str.tostring(rr_ratio, "#.#"),
                 color=color.new(bull_color, 80), textcolor=bull_color, style=label.style_label_left, size=size.tiny)
        else
            label.set_x(rr_lbl, bar_index + 2)
else
    box.delete(ob_box_obj)
    ob_box_obj := na
    line.delete(entry_ln)
    entry_ln   := na
    line.delete(sl_ln)
    sl_ln      := na
    line.delete(tp1_ln)
    tp1_ln     := na
    line.delete(tp2_ln)
    tp2_ln     := na
    label.delete(rr_lbl)
    rr_lbl     := na
    drawn_ob_bar := na

// BACKTEST VISUALS
plotshape(bt_trigger_long and show_backtest,  title="BT LONG",  style=shape.triangleup,   location=location.belowbar, color=color.new(bull_color, 20), size=size.tiny)
plotshape(bt_trigger_short and show_backtest, title="BT SHORT", style=shape.triangledown, location=location.abovebar, color=color.new(bear_color, 20), size=size.tiny)
plotchar(bt_in_position and bt_dir == 1 and show_backtest,  title="BT In LONG",  char="▲", color=color.new(bull_color, 40), location=location.abovebar)
plotchar(bt_in_position and bt_dir == -1 and show_backtest, title="BT In SHORT", char="▼", color=color.new(bear_color, 40), location=location.belowbar)
plotchar(bt_exit_reason == 1 and show_backtest, title="BT EXIT TP2", char="●", color=color.blue,   location=location.abovebar, size=size.small)
plotchar(bt_exit_reason == 2 and show_backtest, title="BT EXIT TP1", char="●", color=color.orange, location=location.abovebar, size=size.small)
plotchar(bt_exit_reason == 3 and show_backtest, title="BT EXIT SL",  char="●", color=color.red,    location=location.abovebar, size=size.small)
plotchar(bt_exit_reason == 4 and show_backtest, title="BT EXIT TMO", char="●", color=color.gray,   location=location.abovebar, size=size.small)

// INFO PANEL
string h4_state_str = h4_state == 0 ? "IDLE" : h4_state == 1 ? "C1" : h4_state == 2 ? (h4_direction == 1 ? "C2 LONG" : "C2 SHORT") : h4_state == 3 ? (h4_direction == 1 ? "SETUP ▲" : "SETUP ▼") : "?"
color  h4_state_col = h4_state == 3 ? (h4_direction == 1 ? bull_color : bear_color) : h4_state == 2 ? color.orange : color.gray
string h1_conf_str = not h4_setup_active ? "—" : h1_confirmed ? "CONFIRMED ✓" : "WAIT"
color  h1_conf_col = not h4_setup_active ? color.gray : h1_confirmed ? bull_color : color.orange
string dol_str = (not h4_setup_active or na(dol_level)) ? "—" : str.tostring(dol_level, "#.#####")
string status_str = ob_detected ? "OB ▶ ENTRY" : full_setup and not ob_detected ? "WAIT OB" : h4_setup_active and not h1_confirmed ? "WAIT H1 TS" : h4_state == 2 ? "WAIT C3" : "—"
color  status_col = ob_detected ? (h4_direction == 1 ? bull_color : bear_color) : h4_state >= 2 ? color.orange : color.gray

color col_lbl = color.rgb(200, 200, 210)
color col_dol = color.rgb(100, 160, 255)
color col_bg  = color.new(color.rgb(15, 15, 28), 20)

var table info_tbl = table.new(position.top_right, 2, 5,
     bgcolor=color.new(color.rgb(10, 10, 20), 15),
     border_color=color.new(color.gray, 50), border_width=1,
     frame_color=color.new(color.gray, 40), frame_width=1)

if barstate.islast and show_panel
    table.cell(info_tbl, 0, 0, "BIAS",  text_color=col_lbl,  text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 1, 0, bias_str, text_color=bias_col, text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 0, 1, "H4",     text_color=col_lbl,  text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 1, 1, h4_state_str, text_color=h4_state_col, text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 0, 2, "H1",     text_color=col_lbl,  text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 1, 2, h1_conf_str, text_color=h1_conf_col, text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 0, 3, "STATUS", text_color=col_lbl,  text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 1, 3, status_str, text_color=status_col, text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 0, 4, "DOL",    text_color=col_lbl,  text_size=size.normal, bgcolor=col_bg)
    table.cell(info_tbl, 1, 4, dol_str,  text_color=col_dol,  text_size=size.normal, bgcolor=col_bg)

// BACKTEST STATS TABLE
var table bt_tbl = table.new(position.bottom_right, 3, 10,
     bgcolor=color.new(color.black, 20),
     border_color=color.new(color.gray, 50), border_width=1)

if barstate.islast and show_backtest
    table.cell(bt_tbl, 0, 0, "TRADES", text_color=color.gray, text_size=size.small, bgcolor=color.new(color.black, 40))
    table.cell(bt_tbl, 1, 0, "WINS",   text_color=color.gray, text_size=size.small, bgcolor=color.new(color.black, 40))
    table.cell(bt_tbl, 2, 0, "WIN%",   text_color=color.gray, text_size=size.small, bgcolor=color.new(color.black, 40))
    table.cell(bt_tbl, 0, 1, str.tostring(bt_total_trades),          text_color=color.white,  text_size=size.normal)
    table.cell(bt_tbl, 1, 1, str.tostring(bt_wins),                  text_color=color.green,  text_size=size.normal)
    table.cell(bt_tbl, 2, 1, str.tostring(bt_win_rate, "#.#") + "%", text_color=color.yellow, text_size=size.normal)
    table.cell(bt_tbl, 0, 2, "", bgcolor=color.new(color.black, 60))
    table.cell(bt_tbl, 1, 2, "", bgcolor=color.new(color.black, 60))
    table.cell(bt_tbl, 2, 2, "", bgcolor=color.new(color.black, 60))
    table.cell(bt_tbl, 0, 3, "AVG PIPS", text_color=color.gray, text_size=size.small, bgcolor=color.new(color.black, 40))
    table.cell(bt_tbl, 1, 3, "MAX PIPS", text_color=color.gray, text_size=size.small, bgcolor=color.new(color.black, 40))
    table.cell(bt_tbl, 2, 3, "MIN PIPS", text_color=color.gray, text_size=size.small, bgcolor=color.new(color.black, 40))
    table.cell(bt_tbl, 0, 4, str.tostring(bt_avg_pips, "#.#"), text_color=color.white, text_size=size.normal)
    table.cell(bt_tbl, 1, 4, na(bt_max_pips) ? "—" : str.tostring(bt_max_pips, "#.#"), text_color=color.green, text_size=size.normal)
    table.cell(bt_tbl, 2, 4, na(bt_min_pips) ? "—" : str.tostring(bt_min_pips, "#.#"), text_color=color.red, text_size=size.normal)
    table.cell(bt_tbl, 0, 5, "", bgcolor=color.new(color.black, 60))
    table.cell(bt_tbl, 1, 5, "", bgcolor=color.new(color.black, 60))
    table.cell(bt_tbl, 2, 5, "", bgcolor=color.new(color.black, 60))
    table.cell(bt_tbl, 0, 6, "H4 STATE", text_color=color.gray, text_size=size.small, bgcolor=color.new(color.black, 40))
    table.cell(bt_tbl, 1, 6, "H1 CONF",  text_color=color.gray, text_size=size.small, bgcolor=color.new(color.black, 40))
    table.cell(bt_tbl, 2, 6, "OB TRIG",  text_color=color.gray, text_size=size.small, bgcolor=color.new(color.black, 40))
    string _h4_str = h4_state == 0 ? "IDLE" : h4_state == 1 ? "C1" : h4_state == 2 ? "C2" : "SETUP"
    table.cell(bt_tbl, 0, 7, _h4_str, text_color=color.white, text_size=size.small)
    table.cell(bt_tbl, 1, 7, h1_confirmed ? "✓" : "✗", text_color=h1_confirmed ? color.green : color.gray, text_size=size.small)
    table.cell(bt_tbl, 2, 7, (bt_trigger_long or bt_trigger_short) ? "⚡" : "—", text_color=color.yellow, text_size=size.small)
    table.cell(bt_tbl, 0, 8, "", bgcolor=color.new(color.black, 60))
    table.cell(bt_tbl, 1, 8, "", bgcolor=color.new(color.black, 60))
    table.cell(bt_tbl, 2, 8, "", bgcolor=color.new(color.black, 60))
    table.cell(bt_tbl, 0, 9, "TOTAL PIPS", text_color=color.gray, text_size=size.small, bgcolor=color.new(color.black, 40))
    table.cell(bt_tbl, 1, 9, str.tostring(bt_total_pips, "+#.##;-#.##"), text_color=bt_total_pips >= 0 ? color.green : color.red, text_size=size.large)
    table.cell(bt_tbl, 2, 9, "", bgcolor=color.new(color.black, 20))

// VISUALS - H1 RANGE BOX
bool show_h1_range = (is_h1 or is_m15) and show_h1_box and h1_confirmed and not na(h1_ts_prev_high)
color h1_box_col = is_h1 ? color.new(h4_direction == 1 ? bull_color : bear_color, 85) : color.new(color.gray, 92)
var box h1_box_obj = na
if show_h1_range
    if na(h1_box_obj)
        h1_box_obj := box.new(left=h1_ts_bar, top=h1_ts_prev_high, right=bar_index + 50, bottom=h1_ts_prev_low,
             border_color=color.new(h4_direction == 1 ? bull_color : bear_color, 50), bgcolor=h1_box_col, extend=extend.right, xloc=xloc.bar_index)
    else
        box.set_right(h1_box_obj, bar_index + 50)
        box.set_bgcolor(h1_box_obj, h1_box_col)
else
    if not na(h1_box_obj)
        box.delete(h1_box_obj)
        h1_box_obj := na